#!/bin/bash
# jeeves-mcp — start the Jeeves MCP bridge for an assistant (stdio). The course kit's launcher: no
# dependency, no checkout, no JEB — one Python 3.9+ and this directory.
#
#   jeeves-mcp                      (the assistant runs it; stdio is the protocol)
#   jeeves-mcp --doctor             one connection report (endpoint, token file, room state) and exit 0/1
#
# Configuration, in this order: environment, then the kit's room file (JEEVES_ROOM_FILE, default
# ~/.config/jeeves/room.env — written by the course's Connect Jeeves step), then defaults:
#   WORKBENCH_URL          the room's HTTPS address (https://room-N.<class domain>)
#   WORKBENCH_BEARER_FILE  the room token file (default ~/.config/jeeves/room-token; chmod 600)
#   WORKBENCH_MCP_CA_FILE  the class CA bundle when this Python lacks it (optional)
# Nothing of the token is printed. Paths with spaces are fine (every expansion is quoted).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOM_FILE="${JEEVES_ROOM_FILE:-$HOME/.config/jeeves/room.env}"
if [ -f "$ROOM_FILE" ]; then
  # KEY=VALUE lines (an `export ` prefix and surrounding quotes are fine; the value may hold `=`);
  # the environment wins over the file; the last line counts with or without a final newline
  while IFS='=' read -r k v || [ -n "$k" ]; do
    k="$(printf '%s' "$k" | tr -d '[:space:]')"; k="${k#export}"
    case "$k" in ''|\#*) continue ;; esac
    v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
    case "$v" in \"*\") v="${v#\"}"; v="${v%\"}" ;; \'*\') v="${v#\'}"; v="${v%\'}" ;; esac
    case "$k" in WORKBENCH_URL|WORKBENCH_BEARER_FILE|WORKBENCH_MCP_CA_FILE|WORKBENCH_TARGET|WORKBENCH_MCP_MAX_CHARS|WORKBENCH_MCP_CALL_TIMEOUT|JEEVES_PYTHON)
      [ -n "${!k:-}" ] || export "$k=$v" ;;
    esac
  done < "$ROOM_FILE"
fi
# the token lives in the FILE (re-read per call: a rotation is a file write) — never in the environment
unset WORKBENCH_BEARER
export WORKBENCH_BEARER_FILE="${WORKBENCH_BEARER_FILE:-$HOME/.config/jeeves/room-token}"
PY="${JEEVES_PYTHON:-}"
if [ -z "$PY" ]; then
  for c in python3 python; do command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null && { PY="$c"; break; }; done
fi
[ -n "$PY" ] || { echo "[jeeves-mcp] no Python 3.9+ on PATH (set JEEVES_PYTHON)" >&2; exit 3; }
exec "$PY" "$HERE/workbench_mcp.py" "$@"
