backend/build/
backend/.gradle/
# An optional copy of a JEB install under backend/engine (JEB_HOME is the normal way); never commit an engine
backend/engine/
.gradle/
build/

# Runs sidecar: python venv + the frida-server binary — fetch with backend/runs/pull-frida.sh
backend/runs/venv/
backend/runs/server/
# Runs data (RunStore JSONL)
backend/.workbench/
backend/runs/__pycache__/

# Multi-LLM runtime state (redundant with backend/.workbench/ above, listed for clarity):
# llm-keys.json = write-only API keys (chmod 600) — NEVER commit
# llm.json = user provider config (baseUrl/default models)
backend/.workbench/llm-keys.json
backend/.workbench/llm.json

# Playwright MCP screenshot/artifact scratch dir
.playwright-mcp/

# Repo-root artifact drop zone (the fs.list/browse default dir): a stray
# `git add -A` must never sweep in an APK, a JEB database or a JEB distribution
/*.apk
/*.jdb2
/*.zip

# Frontend toolchain (web/): TypeScript sources live in web/src; node_modules is local tooling
web/node_modules/

# Frontend build output (tsc from web/src) — regenerated by `cd web && npm run build` and by backend/workbench.sh
web/js/

# local QA/ops state: browser driver, scripts, logs, scratch (never /tmp)
.qa/
mcp/__pycache__/
