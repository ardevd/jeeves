[Unit]
Description=Jeeves overnight campaign (%i hours, eight agents per session)
Wants=jeeves.service network-online.target
After=jeeves.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=jeeves
Group=jeeves
WorkingDirectory=/opt/jeeves/source/ops/cloud
EnvironmentFile=/etc/jeeves/runtime.env
ExecStart=/usr/bin/python3 -u /opt/jeeves/source/ops/cloud/campaign.py run --config /var/lib/jeeves/campaign/config.json --hours %i
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity
TimeoutStopSec=infinity
TasksMax=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
